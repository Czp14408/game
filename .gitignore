# Godot 缓存（不进入版本管理）
.godot/

# 导出产物与试玩包（体积大）
dist/
build/
*.exe
*.pck
*.tpz

# 工具本地状态
.workbuddy/

# 真渲染截图验证的产物（由 --screenshots 生成，不入库）
测试单次问题反馈/_shots/

# 真渲染截图产物（run_screenshots.bat / --screenshots 一键重新生成，不入库）
_验证/截图/

# 原始素材投递区（源图 + 主角动作表；正式使用的一套已复制进 godot_prototype/assets/）
# 注意：这里必须带前导斜杠，只忽略仓库根的 ui/。
# 写成 "ui/" 会匹配任意层级的 ui 目录，把 godot_prototype/assets/ui/ 一起吞掉，
# 结果就是战斗组件面板一张都没入库（2026-10-07 发现并修正）。
/ui/

# 系统
Thumbs.db
desktop.ini
.DS_Store
